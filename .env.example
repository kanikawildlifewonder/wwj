# WWJ - Wildlife Wonder Jewellery
# Environment Variables

# ---------------------------------------------
# Clerk Authentication
# ---------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# ---------------------------------------------
# Supabase / Prisma
# ---------------------------------------------
# DATABASE_URL:
# Use the Supabase pooled / transaction URL for app runtime.
# Example: port 6543 with pgbouncer=true
DATABASE_URL="postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL:
# Use the direct non-pooled Postgres URL for Prisma build-time access,
# introspection, migrations, and other one-off operations.
# Example: port 5432
DIRECT_URL="postgresql://postgres.project-ref:password@aws-1-region.pooler.supabase.com:5432/postgres"

# Optional override for node-postgres pool size inside the app.
# Runtime defaults to 1. Build uses a slightly larger pool automatically.
PG_POOL_MAX=1

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------
# Razorpay
# ---------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---------------------------------------------
# App
# ---------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Wildlife Wonder Jewellery

# ---------------------------------------------
# Optional: Email (Resend)
# ---------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
