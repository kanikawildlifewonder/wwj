// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}


model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  images       String[]
  video        String?
  mainCategory String   @default("wwj")
  category     String
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
}

model Order {
  id                String   @id @default(cuid())
  clerkUserId       String?  // Optional, if user is guest
  customerName      String
  customerEmail     String
  totalAmount       Float
  status            String   @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED
  razorpayPaymentId String?  @map("razorpay_payment_id")
  razorpayOrderId   String?  @map("razorpay_order_id")
  razorpaySignature String?  @map("razorpay_signature")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float    // Price at the time of purchase

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model PageContent {
  id        String   @id // e.g., "home-hero", "about-story"
  content   String   // JSON string containing text, image URLs, etc.
  updatedAt DateTime @updatedAt
}

model Event {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  category         String   // Event, Collaboration, Exhibition, Press Feature, Conservation Initiative, Other
  status           String   @default("DRAFT") // DRAFT, PUBLISHED
  featuredImage    String   @map("featured_image")
  galleryImages    String[] @map("gallery_images")
  shortDescription String   @map("short_description")
  fullDescription  String   @map("full_description")
  eventDate        DateTime @map("event_date")
  location         String?
  partnerName      String?  @map("partner_name")
  partnerLogo      String?  @map("partner_logo")
  partnerWebsite   String?  @map("partner_website")
  videoUrl         String?  @map("video_url")
  relatedProducts  String[] @map("related_products") // Array of Product IDs
  seoTitle         String?  @map("seo_title")
  seoDescription   String?  @map("seo_description")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   // "PERCENTAGE" or "FIXED"
  value     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


